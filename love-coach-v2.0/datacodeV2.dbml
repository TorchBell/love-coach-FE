// Love & Fitness Project - DBML
// Updated: Removed meal_type, img_url, memo from users_food

Table users {
users_id bigint [pk, increment, note: '사용자 ID']
email varchar(100) [not null, unique, note: '로그인 ID']
password varchar(255) [not null, note: '암호화된 비밀번호']
nickname varchar(50) [not null, note: '닉네임']
gender char(1) [note: 'M or F']
birth_date date [note: '생년월일']
credit int [default: 0, note: '보유 크레딧']
is_active boolean [not null, default: true, note: '활성 상태 (true:활동, false:탈퇴)']
created_at datetime [default: 'now()', note: '가입일']
modified_at datetime [default: 'now()', note: '수정일']
}

Table npc {
npc_id bigint [pk, increment, note: 'NPC ID']
name varchar(50) [not null, note: '캐릭터 이름']
personality text [note: '성격 프롬프트']
created_at datetime [default: 'now()']
modified_at datetime [default: 'now()']
}

Table users_npc {
users_npc_id bigint [pk, increment, note: '관계 ID']
users_id bigint [not null, note: 'FK: Users']
npc_id bigint [not null, note: 'FK: NPC']
affection_score int [default: 0, note: '호감도 (0~100)']
current_state varchar(20) [default: 'NORMAL', note: 'NORMAL, ANGRY, HAPPY']
created_at datetime [default: 'now()']
modified_at datetime [default: 'now()']
}

Table food {
food_id varchar(20) [pk, note: '식품코드']
food_name varchar(200) [not null, note: '식품명']
calory decimal(10,2) [note: 'kcal/100g']
water decimal(10,2)
protein decimal(10,2)
fat decimal(10,2)
carb decimal(10,2)
sugar decimal(10,2)
weight decimal(10,2)
}

Table users_food {
users_food_id bigint [pk, increment, note: '식단 기록 ID']
users_id bigint [not null, note: 'FK: Users']
food_id varchar(20) [not null, note: 'FK: Food']
// Removed: meal_type, img_url, memo
date date [not null, note: '식사 날짜']
quantity decimal(5,2) [default: 1.0, note: '섭취량']
created_at datetime [default: 'now()']
modified_at datetime [default: 'now()']
}

Table muscle_exercise {
muscle_exercise_id bigint [pk, increment, note: '근력운동 종목 ID']
name varchar(100) [not null, note: '운동명']
part varchar(50) [note: '운동 부위']
}

Table cardio_exercise {
cardio_exercise_id bigint [pk, increment, note: '유산소 종목 ID']
name varchar(100) [not null, note: '운동명']
met_value decimal(5,2) [note: 'MET 계수']
}

Table muscle_log {
muscle_log_id bigint [pk, increment, note: '근력 기록 ID']
users_id bigint [not null, note: 'FK: Users']
muscle_exercise_id bigint [not null, note: 'FK: Muscle Exercise']
date date [not null, note: '운동 날짜']
set_count int
reps_per_set int
weight decimal(5,2) [note: '중량(kg)']
created_at datetime [default: 'now()']
modified_at datetime [default: 'now()']
}

Table cardio_log {
cardio_log_id bigint [pk, increment, note: '유산소 기록 ID']
users_id bigint [not null, note: 'FK: Users']
cardio_exercise_id bigint [not null, note: 'FK: Cardio Exercise']
date date [not null, note: '운동 날짜']
duration_minutes int [note: '운동 시간(분)']
burned_kcal decimal(10,2) [note: '소모 칼로리']
created_at datetime [default: 'now()']
modified_at datetime [default: 'now()']
}

Table gallery {
gallery_id bigint [pk, increment, note: '갤러리 ID']
title varchar(100) [not null]
image_url varchar(255) [not null, note: '메인 이미지']
b_cut_image_url varchar(255) [note: 'B컷 이미지']
letter text [note: '편지 내용']
unlock_condition varchar(255) [note: '해금 조건']
}

Table achievement {
achievement_id bigint [pk, increment, note: '업적 ID']
title varchar(100) [not null]
description text
condition_type varchar(50)
icon_url varchar(255)
reward_gallery_id bigint [note: '보상 갤러리 ID']
}

Table users_achievement {
users_achievement_id bigint [pk, increment, note: '유저 업적 ID']
users_id bigint [not null, note: 'FK: Users']
achievement_id bigint [not null, note: 'FK: Achievement']
achieved_at datetime [default: 'now()', note: '달성 일시']
}

Table users_gallery {
users_gallery_id bigint [pk, increment, note: '유저 갤러리 ID']
users_id bigint [not null, note: 'FK: Users']
gallery_id bigint [not null, note: 'FK: Gallery']
created_at datetime [default: 'now()', note: '획득 일시']
is_opened boolean [not null, default: false]
is_favorite boolean [not null, default: false]
}

Table quest {
quest_id bigint [pk, increment, note: '퀘스트 ID']
title varchar(100) [not null]
content text
npc_id bigint [note: 'Null=공통']
credit int [default: 0]
}

Table users_quest {
users_quest_id bigint [pk, increment, note: '유저 퀘스트 ID']
users_id bigint [not null, note: 'FK: Users']
quest_id bigint [not null, note: 'FK: Quest']
is_achieved boolean [default: false]
created_at datetime [default: 'now()']
}

Table chat_log {
chat_id bigint [pk, increment, note: '채팅 ID']
users_id bigint [not null, note: 'FK: Users']
npc_id bigint [not null, note: 'FK: NPC']
message_user text
message_ai text
context text [note: '문맥 요약']
created_at datetime [default: 'now()']
}

// Relationships
Ref: users_npc.users_id > users.users_id [delete: cascade]
Ref: users_npc.npc_id > npc.npc_id

Ref: users_food.users_id > users.users_id [delete: cascade]
Ref: users_food.food_id > food.food_id

Ref: muscle_log.users_id > users.users_id [delete: cascade]
Ref: muscle_log.muscle_exercise_id > muscle_exercise.muscle_exercise_id

Ref: cardio_log.users_id > users.users_id [delete: cascade]
Ref: cardio_log.cardio_exercise_id > cardio_exercise.cardio_exercise_id

Ref: achievement.reward_gallery_id > gallery.gallery_id

Ref: users_achievement.users_id > users.users_id [delete: cascade]
Ref: users_achievement.achievement_id > achievement.achievement_id

Ref: users_gallery.users_id > users.users_id [delete: cascade]
Ref: users_gallery.gallery_id > gallery.gallery_id

Ref: chat_log.users_id > users.users_id [delete: cascade]
Ref: chat_log.npc_id > npc.npc_id

Ref: quest.npc_id > npc.npc_id

Ref: users_quest.users_id > users.users_id [delete: cascade]
Ref: users_quest.quest_id > quest.quest_id